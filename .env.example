# Copy this file to .env and set the local values.
# Do not commit .env.

# Local project directory. Empty = folder containing config.py.
PILUITUS_PROJECT_ROOT=

# Per-run logs are split into session_DDMMYYYY_HH.MM.log,
# diagnostic_DDMMYYYY_HH.MM.log and errors_log_DDMMYYYY_HH.MM.log.
# A numeric suffix is added if another run already used that minute.
# The path is relative to PILUITUS_PROJECT_ROOT unless it is absolute.
PILUITUS_LOG_DIR=trading_logs
# Request a durable disk sync for session/diagnostic logs every N seconds.
# Set to 0 to fsync every record (more disk I/O). The error log is fsync'ed per record.
PILUITUS_LOG_FSYNC_INTERVAL_SECONDS=1.0

# Privacy filters for console and per-run log files.
PILUITUS_LOG_REDACT_TELEGRAM_ID=true
PILUITUS_LOG_REDACT_PROJECT_PATH=true

# Refuse new entries outside an active Finam instrument session or in the final N minutes.
# Uses the authenticated /v1/assets/{symbol}/schedule endpoint (Moscow time).
PILUITUS_ENTRY_CUTOFF_MINUTES=5
FINAM_ASSET_SCHEDULE_CACHE_SEC=300

# PAPER_TRADING=true uses the internal pseudo-account; Finam account IDs are not required.
PAPER_TRADING=True

# PAPER transaction costs. Set the exact commission from your own Finam tariff.
# Percent per side (e.g. 0.03 means 0.03% on entry AND 0.03% on exit).
# Replace 0.0 with the actual commission rate from your Finam tariff.
# At 0.0 the simulator intentionally models no commission; it is NOT net-of-fees.
PILUITUS_PAPER_COMMISSION_PCT=0.0
# Additional adverse slippage in basis points on top of executable Ask/Bid.
# The bid/ask spread itself is already included by the BBO fill side.
# Keep 0.0 until a separately justified slippage model is selected.
PILUITUS_PAPER_SLIPPAGE_BPS=0.0
# Top-15 stability: score-only turnover is capped per refresh. Stale members are removed immediately.
PILUITUS_FUNNEL_REFRESH_SEC=15
PILUITUS_FUNNEL_MAX_REPLACEMENTS_PER_REFRESH=1
PILUITUS_FUNNEL_RETENTION_SCORE_GAP=5.0
PILUITUS_FUNNEL_MIN_HOLD_SEC=60
PILUITUS_FUNNEL_REPLACEMENT_CONFIRMATIONS=2

# Enable depth-based partial PAPER entry fills only after confirming Finam ORDER_BOOK
# buy_size/sell_size units for this feed. Allowed: unknown (safe default), shares, lots.
PILUITUS_PAPER_BOOK_SIZE_UNIT=unknown
# Maximum share of displayed depth consumed by a simulated PAPER order (1..100%).
# Conservative default; activate depth model only after confirming Finam size units.
PILUITUS_PAPER_MAX_BOOK_PARTICIPATION_PCT=10.0

# Finam ORDER_BOOK recovery. Persistent crossed books and stale open-position
# BBO are recovered by restarting the WS subscription and waiting for a full
# provider snapshot. REST snapshots are diagnostic-only and never executable.
FINAM_CROSSED_BBO_RESUBSCRIBE_AFTER_SEC=5
FINAM_CROSSED_BBO_RESUBSCRIBE_COOLDOWN_SEC=30
FINAM_POSITION_REST_BBO_REFRESH_SEC=5
FINAM_POSITION_REST_BBO_TRIGGER_AGE_SEC=1.5

# Final PAPER entry guard: reject a fresh but economically unusable wide BBO.
PILUITUS_MAX_ENTRY_SPREAD_PCT=0.50

# Telegram. TG_USER_ID is the operator/chat ID; the bot's own numeric ID
# is provided by Telegram at runtime and is redacted from aiogram logs.
TG_BOT_TOKEN=
TG_USER_ID=

# Finam
FINAM_TOKEN=
# Optional brokerage account ID; used only for LIVE execution. PAPER uses an internal pseudo-account.
FINAM_ACCOUNT_ID=
# Legacy LIVE-only compatibility fallback. Ignored by PAPER mode.
FINAM_CLIENT_ID=
FINAM_DEMO=True
FINAM_METADATA_REFRESH_SEC=900
# LIVE-only retry interval for brokerage-account discovery (15..300 seconds).
FINAM_ACCOUNT_DISCOVERY_RETRY_SEC=60
FINAM_METADATA_REQUEST_INTERVAL_SEC=0.36
# Public market-trade subscriptions follow active Top-15 plus open positions.
FINAM_INSTRUMENT_TRADES_TOP_N=15
FINAM_INSTRUMENT_TRADES_REFRESH_SEC=5
FINAM_INSTRUMENT_TRADES_MIN_HOLD_SEC=60
FINAM_INSTRUMENT_TRADES_MAX_OVERBOOK=5
# Order-book subscription hysteresis prevents repeated snapshot warm-ups on marginal Top-15 rotations.
FINAM_ORDER_BOOK_MIN_HOLD_SEC=20
FINAM_ORDER_BOOK_MAX_OVERBOOK=5

# vLLM
VLLM_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# Optional: set this only when your vLLM server requires a specific model name/path.
# VLLM_MODEL=your-model-name-or-server-path
VLLM_TIMEOUT=30
VLLM_MAX_TOKENS=768
# After confirmed vLLM connection failures, suppress new requests with exponential backoff.
# First cooldown is 5s; repeated outages grow up to 60s. Requests still fail closed as HOLD.
PILUITUS_VLLM_CONNECT_BACKOFF_BASE_SEC=5
PILUITUS_VLLM_CONNECT_BACKOFF_MAX_SEC=60

# Redis / Memurai
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Trading configuration
TRADING_DEPOSIT=400000
PILUITUS_MAX_GROSS_EXPOSURE_PCT=0.10
# One position may use at most 3% of deposit; gross exposure remains 10%.
PILUITUS_MAX_SINGLE_POSITION_PCT=0.03

# Re-entry protection after a stop-loss (side-specific).
# First stop: 180s pause for the same ticker and direction.
PILUITUS_STOP_LOSS_COOLDOWN_SEC=180
# Two same-direction stop-losses within 30 minutes trigger a 15-minute pause.
PILUITUS_REPEAT_SL_WINDOW_SEC=1800
PILUITUS_REPEAT_SL_LIMIT=2
PILUITUS_REPEAT_SL_COOLDOWN_SEC=900

# Shadow-only break-even study. Does not modify actual SL/TP or close positions.
# Arm the hypothetical net break-even stop after 1.0R of executable BBO MFE.
PILUITUS_SHADOW_BE_ENABLED=true
PILUITUS_SHADOW_BE_ARM_R=1.0

# Money Management: max aggregate downside from all active stop-loss levels.
PILUITUS_MAX_OPEN_STOP_RISK_PCT=0.01
# Equity high-water mark drawdown: warn at 3%, block new entries at 5%.
PILUITUS_DRAWDOWN_WARNING_PCT=0.03
PILUITUS_MAX_DRAWDOWN_PCT=0.05
# Global consecutive-loss circuit breaker.
PILUITUS_LOSS_STREAK_3_PAUSE_SEC=600
PILUITUS_LOSS_STREAK_5_PAUSE_SEC=1800
# Stop all new entries for the rest of the Moscow trading date after N losses.
PILUITUS_LOSS_STREAK_HARD_STOP=5
