# Copy this file to .env and set the local values.
# Do not commit .env.

# Local project directory. Empty = folder containing config.py.
PILUITUS_PROJECT_ROOT=

# Per-run thematic logs: session, diagnostic, errors_log, shadow, vllm,
# market, execution and verdicts. All files share one RUN_ID and timestamp format.
# Every file rotates at 15 MiB into _part02, _part03, ... segments.
# The path is relative to PILUITUS_PROJECT_ROOT unless it is absolute.
PILUITUS_LOG_DIR=trading_logs
# Non-error logs are fsync'ed every N seconds; errors are fsync'ed per record.
PILUITUS_LOG_FSYNC_INTERVAL_SECONDS=1.0

# Privacy filters for console and per-run log files.
PILUITUS_LOG_REDACT_TELEGRAM_ID=true
PILUITUS_LOG_REDACT_PROJECT_PATH=true

# Refuse new entries outside an active Finam instrument session or in the final N minutes.
# Additional absolute entry cutoff in Moscow time (applies even if Finam schedule says later).
# Position monitoring and exits continue after this time.
PILUITUS_ENTRY_CUTOFF_MINUTES=5
PILUITUS_ENTRY_HARD_CUTOFF_MSK=22:00
FINAM_ASSET_SCHEDULE_CACHE_SEC=300

# PAPER_TRADING=true uses the internal pseudo-account; Finam account IDs are not required.
PAPER_TRADING=True

# Strategy Shadow remains research-only: its score is not a calibrated probability of profit
# and is never used as an execution gate. PAPER entries additionally require a fresh confirmed
# ORDER_BOOK and a round-trip cost/ATR ratio within the configured ceiling.

# Finam RF securities tariff: conservative maximum rate supplied by the operator.
# Percent per side; 0.0354 means 0.0354% on entry AND 0.0354% on exit.
PILUITUS_PAPER_COMMISSION_PCT=0.0354
# Additional adverse slippage in basis points PER SIDE on top of executable Ask/Bid.
# The bid/ask spread itself is already included by the BBO fill side.
# Set a separately justified value >0 before enabling new PAPER entries.
# 0.0 is fail-closed: new PAPER entries are blocked; monitoring/exits remain active.
# Do not invent a value: base it on observed or deliberately conservative fill-cost evidence.
# Calibration assumption for PAPER only: 1 bp per side; replace only after measured fill data.
PILUITUS_PAPER_SLIPPAGE_BPS=1.0
# PAPER-only entry guard: block when persistent 5s queue and 30s aggressor flow strongly conflict.
PILUITUS_PAPER_QUEUE_FLOW_CONFLICT_GUARD=1

# Maximum acceptable spread relative to M1 ATR; recalibrate only from shadow outcomes.
PILUITUS_MAX_SPREAD_TO_ATR_RATIO=0.50
# Final PAPER execution ceiling: include spread, both commission sides and configured slippage.
# Every approved candidate must satisfy this stricter ratio before an order can be opened.
PILUITUS_MAX_ENTRY_COST_TO_ATR_RATIO=0.50
# Wider analytical ceiling used ONLY to send a candidate to vLLM for assessment.
# It never overrides the final execution ceiling above; candidates over 0.50 ATR are still not executable.
PILUITUS_MAX_PRE_LLM_COST_TO_ATR_RATIO=1.25
# ATR is calculated only from completed M1 bars. History is warmed from Finam at Top-15 selection.
PILUITUS_ATR_MIN_PERIODS=5
PILUITUS_ATR_MAX_AGE_SEC=120

# PAPER-only directional gates: require price/VWAP alignment and fresh signed aggressor flow.
# BUY requires positive buyer flow; SELL requires negative seller flow.
# A confirmed opposite M1 trend is a hard veto unless a fresh matching M1 breakout/pullback
# trigger is confirmed. Persistent fresh 5s queue imbalance is also a veto (3s coverage, 5 samples).
PILUITUS_PAPER_BUY_STRICT_GATE=true
PILUITUS_PAPER_BUY_MIN_FLOW_IMBALANCE=0.10
PILUITUS_PAPER_SELL_STRICT_GATE=true
PILUITUS_PAPER_SELL_MIN_FLOW_IMBALANCE=0.10
# Minimum absolute 5s queue imbalance to veto a PAPER entry in the opposing direction.
PILUITUS_PAPER_OPPOSING_QUEUE_THRESHOLD=0.15

# A neutral VWAP deviation does not veto a locally directional price impulse.
# A materially opposite VWAP/price move still blocks the candidate.
PILUITUS_DIRECTION_MOMENTUM_NEUTRAL_PCT=0.01
PILUITUS_DIRECTION_VWAP_NEUTRAL_PCT=0.03

# Suppress repeated candidates with the same ticker/side/pattern fingerprint.
PILUITUS_AI_CANDIDATE_COOLDOWN_SEC=8.0
# Drop queued market candidates if they wait too long for the LLM worker.
PILUITUS_AI_CANDIDATE_TTL_SEC=5.0
# Minimum occupied 5-second buckets in the prior 55 seconds for a valid volume baseline.
PILUITUS_VOLUME_BASELINE_MIN_BUCKETS=4

# Top-15 stability: score-only turnover is capped per refresh. Stale members are removed immediately.
PILUITUS_FUNNEL_REFRESH_SEC=15
PILUITUS_FUNNEL_MAX_REPLACEMENTS_PER_REFRESH=1
PILUITUS_FUNNEL_RETENTION_SCORE_GAP=5.0
PILUITUS_FUNNEL_MIN_HOLD_SEC=60
PILUITUS_FUNNEL_REPLACEMENT_CONFIRMATIONS=2

# Finam's public ORDER_BOOK schema does not define whether buy_size/sell_size are shares or lots.
# Keep unknown until supported by FINAM_SUPPORT, BROKER_EXPORT or CONTROLLED_RECONCILIATION evidence.
# Set a unit AND evidence source together; otherwise config forces unknown.
PILUITUS_PAPER_BOOK_SIZE_UNIT=unknown
PILUITUS_PAPER_BOOK_SIZE_UNIT_EVIDENCE=
# Maximum share of displayed depth consumed by a simulated PAPER order (1..100%).
# Conservative default; depth is disabled unless the unit/evidence gate passes.
PILUITUS_PAPER_MAX_BOOK_PARTICIPATION_PCT=10.0

# Finam ORDER_BOOK recovery. Persistent crossed books and stale open-position
# BBO are recovered by restarting the WS subscription and waiting for a full
# provider snapshot. REST snapshots are diagnostic-only and never executable.
FINAM_CROSSED_BBO_RESUBSCRIBE_AFTER_SEC=5
FINAM_CROSSED_BBO_RESUBSCRIBE_COOLDOWN_SEC=30
FINAM_POSITION_REST_BBO_REFRESH_SEC=5
FINAM_POSITION_REST_BBO_TRIGGER_AGE_SEC=1.5

# Second-sample quarantine threshold for isolated BBO midpoint jumps.
PILUITUS_BBO_MAX_JUMP_PCT=1.0

# Planned net reward/risk floor after spread, both commissions and slippage.
PILUITUS_MIN_NET_REWARD_TO_RISK=1.0

# Final PAPER entry guard: reject a fresh but economically unusable wide BBO.
PILUITUS_MAX_ENTRY_SPREAD_PCT=0.50
# Throttle repetitive PAPER position wait/resume/BBO guard messages per order.
# Full gap counts and durations remain in the trade journal; triggers/closes are never throttled.
PILUITUS_PAPER_EXIT_STATUS_LOG_INTERVAL_SEC=300
# Retry PAPER open-position exit monitoring independently of market events.
# Retries still require a fresh executable Bid (long) or Ask (short); no stale-price fills.
PILUITUS_PAPER_EXIT_WATCHDOG_INTERVAL_SEC=1.0
# Escalate a latched exit still waiting for a fresh executable BBO; never synthesize fills.
PILUITUS_PAPER_EXIT_STALL_ALERT_SEC=10.0
PILUITUS_PAPER_EXIT_STALL_LOG_INTERVAL_SEC=30.0

# Telegram. TG_USER_ID is the operator/chat ID; the bot's own numeric ID
# is provided by Telegram at runtime and is redacted from aiogram logs.
TG_BOT_TOKEN=
TG_USER_ID=

# Finam
FINAM_TOKEN=
# Optional brokerage account ID; used only for LIVE execution. PAPER uses an internal pseudo-account.
FINAM_ACCOUNT_ID=
# Legacy LIVE-only compatibility fallback. Ignored by PAPER mode.
FINAM_CLIENT_ID=
FINAM_DEMO=True
FINAM_METADATA_REFRESH_SEC=900
# LIVE-only retry interval for brokerage-account discovery (15..300 seconds).
FINAM_ACCOUNT_DISCOVERY_RETRY_SEC=60
FINAM_METADATA_REQUEST_INTERVAL_SEC=0.36
# Public market-trade subscriptions follow active Top-15 plus open positions.
FINAM_INSTRUMENT_TRADES_TOP_N=15
FINAM_INSTRUMENT_TRADES_REFRESH_SEC=5
FINAM_INSTRUMENT_TRADES_MIN_HOLD_SEC=60
FINAM_INSTRUMENT_TRADES_MAX_OVERBOOK=5
# Order-book subscription hysteresis prevents repeated snapshot warm-ups on marginal Top-15 rotations.
FINAM_ORDER_BOOK_MIN_HOLD_SEC=20
FINAM_ORDER_BOOK_MAX_OVERBOOK=5

# vLLM
VLLM_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# Optional: set this only when your vLLM server requires a specific model name/path.
# VLLM_MODEL=your-model-name-or-server-path
VLLM_TIMEOUT=30
VLLM_MAX_TOKENS=768
# Bound concurrent inference calls; queued wait is logged separately from server latency.
PILUITUS_VLLM_MAX_CONCURRENCY=4
# Independent queue consumers; runtime clamps this to vLLM concurrency and a hard max of 4.
PILUITUS_AI_WORKERS=3
# After confirmed vLLM connection failures, suppress new requests with exponential backoff.
# First cooldown is 5s; repeated outages grow up to 60s. Requests still fail closed as HOLD.
PILUITUS_VLLM_CONNECT_BACKOFF_BASE_SEC=5
PILUITUS_VLLM_CONNECT_BACKOFF_MAX_SEC=60

# Redis / Memurai
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Trading configuration
# Canonical start capital. TRADE_DEPOSIT takes precedence; conflicting legacy values fail at startup.
TRADE_DEPOSIT=40000
# Legacy compatibility only; keep equal to TRADE_DEPOSIT if both are present.
# TRADING_DEPOSIT=400000
PILUITUS_MAX_GROSS_EXPOSURE_PCT=0.10
# One position may use at most 3% of deposit; gross exposure remains 10%.
PILUITUS_MAX_SINGLE_POSITION_PCT=0.03
# Suppress repeated same-side PAPER attempts while capital/stop-risk headroom is exhausted.
PILUITUS_PAPER_CAPITAL_REJECT_COOLDOWN_SEC=10

# Re-entry protection after a stop-loss (side-specific).
# First stop: 180s pause for the same ticker and direction.
PILUITUS_STOP_LOSS_COOLDOWN_SEC=180
# Two same-direction stop-losses within 30 minutes trigger a 15-minute pause.
PILUITUS_REPEAT_SL_WINDOW_SEC=1800
PILUITUS_REPEAT_SL_LIMIT=2
PILUITUS_REPEAT_SL_COOLDOWN_SEC=900

# Shadow-only break-even study. Does not modify actual SL/TP or close positions.
# Arm the hypothetical net break-even stop after 1.0R of executable BBO MFE.
PILUITUS_SHADOW_BE_ENABLED=true
PILUITUS_SHADOW_BE_ARM_R=1.0
# PAPER-only active trailing stop. Arms at 1.5R and keeps 0.75R distance from BBO high-water.
PILUITUS_PAPER_TRAILING_ENABLED=true
PILUITUS_PAPER_TRAILING_ARM_R=1.5
PILUITUS_PAPER_TRAILING_DISTANCE_R=0.75

# Confirmed position exit on opposite 15s/30s momentum + fresh aggressor flow.
# Requires 2 distinct fresh trade samples; missing/stale flow is never treated as a reversal.
PILUITUS_PAPER_SIGNAL_EXIT_ENABLED=true
PILUITUS_PAPER_SIGNAL_EXIT_MIN_MOMENTUM_PCT=0.02
PILUITUS_PAPER_SIGNAL_EXIT_MIN_FLOW_IMBALANCE=0.15
PILUITUS_PAPER_SIGNAL_EXIT_MIN_QUEUE_IMBALANCE=0.10
PILUITUS_PAPER_SIGNAL_EXIT_CONFIRMATIONS=2
PILUITUS_PAPER_EXIT_METRICS_MAX_AGE_SEC=5.0
# Scale out half the position from +1R only when opposing flow persists.
# Actual partial fills require an explicitly confirmed ORDER_BOOK size unit (shares/lots).
PILUITUS_PAPER_PARTIAL_PROFIT_ENABLED=true
PILUITUS_PAPER_PARTIAL_PROFIT_ARM_R=1.0
PILUITUS_PAPER_PARTIAL_PROFIT_FRACTION=0.50

# Money Management: max aggregate downside from all active stop-loss levels.
PILUITUS_MAX_OPEN_STOP_RISK_PCT=0.01
# Equity high-water mark drawdown: warn at 3%, block new entries at 5%.
PILUITUS_DRAWDOWN_WARNING_PCT=0.03
PILUITUS_MAX_DRAWDOWN_PCT=0.05
# Global consecutive-loss circuit breaker.
PILUITUS_LOSS_STREAK_3_PAUSE_SEC=600
PILUITUS_LOSS_STREAK_5_PAUSE_SEC=1800
# Stop all new entries for the rest of the Moscow trading date after N losses.
PILUITUS_LOSS_STREAK_HARD_STOP=5


# Web dashboard LAN access (no login configured for the current PAPER test setup).
# Keep access limited to your trusted local network; do not expose this port to the Internet.
APP_HOST=0.0.0.0
APP_PORT=5813
